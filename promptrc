# vim: set filetype=sh:

RESET='\033[0m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'

# Use for simplicity and speed on VMs
simple_prompt_command() {
  [ -z "${HOST}" ] && HOST_VAR='' || HOST_VAR=" \e[32m[host=$HOST]"
  PS1="\n\[$BLUE\]\w\[$RESET\]$HOST_VAR$DEFAULT\n➝  "
}

# Full featured prompt command

# Function to get git branch name
git_branch() {
    git branch --no-color 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'
}

# Function to get git status info (optional, for package version display)
git_status() {
    if git rev-parse --git-dir > /dev/null 2>&1; then
        # Check if package.json exists and extract version
        if [[ -f "package.json" ]]; then
            local version=$(grep '"version"' package.json | head -1 | sed 's/.*"version": *"\([^"]*\)".*/\1/')
            if [[ -n "$version" ]]; then
                echo "📦v$version "
            fi
        fi

        # Check if Cargo.toml exists and extract Rust version
        if command -v rustc >/dev/null 2>&1; then
            local rust_version=$(rustc --version | cut -d' ' -f2)
            echo "🦀v$rust_version "
        fi
    fi
}

prompt_command() {
    local branch=$(git_branch)
    local status=$(git_status)

    PS1="\[$BLUE\]\W\[$RESET\]"  # Current directory name only

    # Add git branch if in a git repo with "on  branch" format
    if [[ -n "$branch" ]]; then
        PS1+=" on  $CYAN$branch$RESET"
    fi

    # Add package/version info
    if [[ -n "$status" ]]; then
        PS1+=" $status"
    fi

    # Add time
    PS1+="at \[$YELLOW\]\t\[$RESET\]"

    # New line and prompt symbol
    PS1+='\n\[\033[1;35m\]❯\[\033[0m\] '
}

# Set the prompt command to run before each prompt
PROMPT_COMMAND=prompt_command

if [[ "$unamestr" == "Darwin" ]]; then
  PROMPT_COMMAND=prompt_command
else
  PROMPT_COMMAND=simple_prompt_command
fi
